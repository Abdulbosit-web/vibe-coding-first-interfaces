# Скопируйте этот файл в .env и заполните. Файл .env никому не отправляйте.

# --- Почта (IMAP) ---
# yandex, mailru, gmail — или адрес сервера, например imap.yandex.ru
IMAP_HOST=yandex
IMAP_PORT=993
IMAP_USER=you@yandex.ru
# Пароль ПРИЛОЖЕНИЯ (не обычный пароль от почты)
IMAP_PASSWORD=

# --- Календарь ---
# Секретная ссылка iCal/ICS. Несколько календарей — через запятую.
ICS_URL=

# --- Telegram ---
# Токен отдельного бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш Telegram ID (число). Узнать: напишите боту @userinfobot
TELEGRAM_CHAT_ID=

# --- Что считать важным ---
# Адреса, домены (@bank.ru) или имена — через запятую
IMPORTANT_SENDERS=buh@example.ru, @bank.example, Иван Клиентов
# Слова в теме или тексте письма. Пусто — «счёт, оплата, срочно, договор»
KEYWORDS=

# --- Прочее ---
TIMEZONE=Europe/Moscow
# За сколько часов смотреть почту
HOURS_BACK=24
# Сколько важных писем показывать максимум
MAX_IMPORTANT=15
